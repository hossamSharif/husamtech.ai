---
import Icon from './Icon.astro';
interface Props { items: string[] }
const { items } = Astro.props;
---

<ul class="space-y-3">
  {
    items.map((item, i) => (
      <li class="reveal flex items-start gap-3" style={`--d:${i * 80}ms`}>
        <span class="mt-0.5 grid size-6 flex-none place-items-center rounded-full bg-tint text-accent">
          <Icon name="check" size={14} />
        </span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
