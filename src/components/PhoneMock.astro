---
// Decorative phone illustration, pure HTML/CSS. `variant` changes the screen layout.
interface Props { variant?: number; class?: string }
const { variant = 0, class: cls } = Astro.props;
const v = variant % 4;
const gradients = [
  'linear-gradient(135deg,#14b8a6,#0f766e)',
  'linear-gradient(135deg,#2dd4bf,#0891b2)',
  'linear-gradient(135deg,#34d399,#0d9488)',
  'linear-gradient(135deg,#5eead4,#0e7490)',
];
---

<div
  class:list={[
    'relative aspect-[9/18.5] rounded-[1.9rem] border border-line bg-surface p-1.5 shadow-[var(--shadow)]',
    !/(^|\s)w-/.test(cls ?? '') && 'w-40',
    cls,
  ]}
  aria-hidden="true"
  dir="ltr"
>
  <div class="relative h-full overflow-hidden rounded-[1.5rem] bg-soft p-2.5">
    <span class="mx-auto block h-3 w-12 rounded-full bg-fg/80"></span>
    <div class="mt-3 flex items-center justify-between">
      <span class="h-2 w-12 rounded bg-fg/70"></span>
      <span class="size-5 rounded-full bg-tint"></span>
    </div>

    <div class="mt-2.5 rounded-xl p-2.5" style={`background:${gradients[v]}`}>
      <span class="block h-1.5 w-10 rounded bg-white/60"></span>
      <span class="mt-2 block h-3 w-16 rounded bg-white"></span>
      {v % 2 === 0 && <span class="mt-3 block h-1.5 w-full rounded-full bg-white/30"><span class="block h-full w-2/3 rounded-full bg-white" /></span>}
      {
        v % 2 === 1 && (
          <span class="mt-2 flex h-6 items-end gap-1">
            {[50, 80, 60, 100, 70].map((h) => <span class="flex-1 rounded-sm bg-white/70" style={`height:${h}%`} />)}
          </span>
        )
      }
    </div>

    {
      v < 2 ? (
        <div class="mt-2.5 grid grid-cols-2 gap-1.5">
          {[0, 1, 2, 3].map(() => (
            <div class="rounded-lg border border-line bg-surface p-1.5">
              <span class="block aspect-[4/3] rounded-md bg-tint" />
              <span class="mt-1.5 block h-1.5 w-3/4 rounded bg-line" />
            </div>
          ))}
        </div>
      ) : (
        <div class="mt-2.5 space-y-1.5">
          {[70, 55, 80, 60].map((w) => (
            <div class="flex items-center gap-2 rounded-lg border border-line bg-surface p-1.5">
              <span class="size-5 flex-none rounded-md bg-tint" />
              <span class="h-1.5 rounded bg-line" style={`width:${w}%`} />
            </div>
          ))}
        </div>
      )
    }

    <div class="absolute inset-x-2.5 bottom-2.5 flex justify-around rounded-xl border border-line bg-surface py-2">
      <span class="size-3 rounded bg-accent"></span>
      <span class="size-3 rounded bg-line"></span>
      <span class="size-3 rounded bg-line"></span>
      <span class="size-3 rounded bg-line"></span>
    </div>
  </div>
</div>
