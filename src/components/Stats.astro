---
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---

<dl class:list={['grid grid-cols-2 gap-4 sm:gap-5', items.length === 4 ? 'lg:grid-cols-4' : 'sm:grid-cols-3']}>
  {
    items.map((s, i) => (
      <div class="card reveal flex flex-col-reverse p-5 sm:p-6" style={`--d:${i * 80}ms`}>
        <dt class="mt-1 text-sm text-muted">{s.label}</dt>
        <dd class="text-3xl font-bold text-accent sm:text-4xl">{s.value}</dd>
      </div>
    ))
  }
</dl>
