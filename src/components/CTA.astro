---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<section class="section !pt-0">
  <div class="container-x">
    <div
      class="reveal relative overflow-hidden rounded-[2rem] px-6 py-14 text-center text-white sm:px-12 sm:py-20"
      style="background:linear-gradient(135deg,#0f766e,#115e59 55%,#134e4a)"
    >
      <div
        class="absolute inset-0 opacity-25"
        style="background-image:radial-gradient(circle at 1px 1px,#fff 1px,transparent 0);background-size:1.75rem 1.75rem;mask-image:radial-gradient(ellipse at center,#000,transparent 70%)"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="h-section">{d.cta.title}</h2>
        <p class="mt-4 text-lg text-white/85">{d.cta.desc}</p>
        <a
          href={`mailto:${d.contact.email}`}
          class="btn mt-8 bg-white text-[#0f766e] hover:-translate-y-0.5 hover:shadow-xl"
        >
          {d.cta.button}
          <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
        </a>
      </div>
    </div>
  </div>
</section>
