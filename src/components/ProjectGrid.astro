---
import DashboardMock from './DashboardMock.astro';
import PhoneMock from './PhoneMock.astro';
interface Project { name: string; category: string; desc: string; tags: string[] }
interface Props { items: Project[]; kind: 'saas' | 'mobile' }
const { items, kind } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2">
  {
    items.map((p, i) => (
      <article class="card reveal overflow-hidden" style={`--d:${(i % 2) * 100}ms`}>
        <div class="relative h-56 overflow-hidden border-b border-line bg-soft sm:h-64">
          <div class="blob -top-1/3 start-1/4 size-80" aria-hidden="true" />
          {kind === 'saas' ? (
            <DashboardMock class="absolute inset-x-6 top-8 sm:inset-x-10" />
          ) : (
            <div class="absolute inset-x-0 top-8 flex justify-center gap-4">
              <PhoneMock variant={i} class="translate-y-6" />
              <PhoneMock variant={i + 2} class="hidden min-[420px]:block" />
            </div>
          )}
        </div>
        <div class="p-6">
          <p class="text-sm font-semibold text-accent">{p.category}</p>
          <h3 class="mt-1 text-xl font-semibold">{p.name}</h3>
          <p class="mt-2 text-muted">{p.desc}</p>
          <ul class="mt-4 flex flex-wrap gap-2" dir="ltr">
            {p.tags.map((tag) => (
              <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-muted">{tag}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
