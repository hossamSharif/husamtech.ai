---
// Decorative SaaS dashboard illustration, pure HTML/CSS.
const bars = [38, 56, 44, 72, 60, 86, 68, 94, 78, 62];
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<div
  class:list={['rounded-2xl border border-line bg-surface shadow-[var(--shadow)] overflow-hidden', cls]}
  aria-hidden="true"
  dir="ltr"
>
  <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
    <span class="size-2.5 rounded-full bg-line"></span>
    <span class="size-2.5 rounded-full bg-line"></span>
    <span class="size-2.5 rounded-full bg-line"></span>
    <span class="ms-3 h-5 flex-1 max-w-40 rounded-md bg-soft"></span>
  </div>
  <div class="grid grid-cols-[3.25rem_1fr] sm:grid-cols-[4.5rem_1fr]">
    <div class="flex flex-col items-center gap-3 border-e border-line py-4">
      <span class="size-7 rounded-lg bg-accent"></span>
      <span class="size-7 rounded-lg bg-tint"></span>
      <span class="size-7 rounded-lg bg-soft"></span>
      <span class="size-7 rounded-lg bg-soft"></span>
    </div>
    <div class="p-4 sm:p-5">
      <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
        {
          [70, 50, 60].map((w, i) => (
            <div class="rounded-xl border border-line p-2.5 sm:p-3">
              <span class="block h-1.5 w-8 rounded bg-line" />
              <span class:list={['mt-2 block h-3 rounded', i === 0 ? 'bg-accent' : 'bg-fg/70']} style={`width:${w}%`} />
            </div>
          ))
        }
      </div>
      <div class="mt-3 rounded-xl border border-line p-3 sm:p-4">
        <div class="flex items-center justify-between">
          <span class="h-2 w-20 rounded bg-fg/70"></span>
          <span class="h-4 w-12 rounded-full bg-tint"></span>
        </div>
        <div class="mt-4 flex h-24 items-end gap-1.5 sm:h-32 sm:gap-2">
          {
            bars.map((h, i) => (
              <span
                class:list={['bar flex-1 rounded-t-md', i === 7 ? 'bg-accent' : 'bg-accent-2/35']}
                style={`height:${h}%;--d:${300 + i * 70}ms`}
              />
            ))
          }
        </div>
      </div>
      <div class="mt-3 space-y-2">
        {
          [64, 48].map((w) => (
            <div class="flex items-center gap-2.5">
              <span class="size-6 flex-none rounded-full bg-tint" />
              <span class="h-2 rounded bg-line" style={`width:${w}%`} />
              <span class="ms-auto h-2 w-8 rounded bg-accent-2/50" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
