---
interface Props { steps: { title: string; desc: string }[] }
const { steps } = Astro.props;
---

<ol class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
  {
    steps.map((s, i) => (
      <li class="card reveal p-6" style={`--d:${i * 90}ms`}>
        <span class="text-4xl font-bold text-accent/30" dir="ltr">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
        <p class="mt-2 text-muted">{s.desc}</p>
      </li>
    ))
  }
</ol>
