---
import Icon from './Icon.astro';
interface Props { items: { icon: string; title: string; desc: string }[]; cols?: 3 | 4 }
const { items, cols = 3 } = Astro.props;
---

<div class:list={['grid gap-4 sm:grid-cols-2 sm:gap-5', cols === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
  {
    items.map((item, i) => (
      <article class="card reveal p-6" style={`--d:${(i % cols) * 90}ms`}>
        <span class="icon-chip">
          <Icon name={item.icon} size={22} />
        </span>
        <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
        <p class="mt-2 text-muted">{item.desc}</p>
      </article>
    ))
  }
</div>
