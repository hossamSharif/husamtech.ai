---
interface Props { name: string; href: string }
const { name, href } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-2.5 font-bold text-lg text-fg" aria-label={name}>
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" class="flex-none">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2dd4bf"></stop>
        <stop offset="1" stop-color="#0f766e"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#logo-g)"></rect>
    <path d="M10 9v14M22 9v14M10 16h12" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <span class="max-[359px]:sr-only">{name}</span>
</a>
