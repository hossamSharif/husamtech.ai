---
interface Props { eyebrow?: string; title: string; desc?: string; center?: boolean }
const { eyebrow, title, desc, center = false } = Astro.props;
---

<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <span class="eyebrow mb-4">{eyebrow}</span>}
  <h2 class="h-section">{title}</h2>
  {desc && <p class="lead mt-4">{desc}</p>}
</div>
