---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import readexUrl from '@fontsource-variable/readex-pro/files/readex-pro-arabic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, dir, lp, stripLang, locales, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const d = t(lang);
const pageTitle = title ? `${title} · ${d.meta.siteName}` : `${d.meta.siteName} — ${d.nav.saas} & ${d.nav.mobile}`;
const desc = description ?? d.meta.description;
const path = stripLang(Astro.url.pathname);
const abs = (p: string) => new URL(p, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(lp(lang, path))} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(lp(l, path))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(lp('en', path))} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={lang === 'ar' ? readexUrl : interUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(lp(lang, path))} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#040f10" media="(prefers-color-scheme: dark)" />
    <!-- Sets the theme before first paint (no flash) and again after each page transition -->
    <script is:inline>
      (function () {
        function apply() {
          var t;
          try {
            t = localStorage.getItem('theme');
          } catch (e) {}
          if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          var el = document.documentElement;
          el.dataset.theme = t;
          el.classList.add('js');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
      >{d.nav.skip}</a
    >
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Theme toggle + mobile menu (delegated, so they survive page transitions)
      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        if (target.closest('[data-theme-toggle]')) {
          const el = document.documentElement;
          const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
          el.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          return;
        }
        const toggle = target.closest('[data-menu-toggle]');
        if (toggle) {
          const menu = document.querySelector('[data-menu]');
          const open = menu?.toggleAttribute('data-open') ?? false;
          toggle.setAttribute('aria-expanded', String(open));
        }
      });

      // Scroll reveal
      function initReveal() {
        const items = document.querySelectorAll('.reveal:not(.is-in)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
