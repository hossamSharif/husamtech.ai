---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DashboardMock from '../../components/DashboardMock.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import CheckList from '../../components/CheckList.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import CTA from '../../components/CTA.astro';
import { t, lp, langPaths, type Lang } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const stack = [...d.stack.items, ...d.stack.items];
---

<Base lang={lang}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="blob -top-48 -start-32 size-[38rem]" aria-hidden="true"></div>
    <div class="blob top-1/3 -end-40 size-[30rem]" style="animation-delay:-6s" aria-hidden="true"></div>

    <div class="container-x relative grid items-center gap-14 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pb-24 lg:pt-24">
      <div>
        <span class="eyebrow reveal mb-6">{d.hero.badge}</span>
        <h1 class="h-display reveal" style="--d:80ms">
          {d.hero.titleA}{' '}<span class="text-gradient">{d.hero.titleAccent}</span>{' '}{d.hero.titleB}
        </h1>
        <p class="lead reveal mt-6 max-w-xl" style="--d:160ms">{d.hero.subtitle}</p>
        <div class="reveal mt-8 flex flex-col gap-3 min-[420px]:flex-row" style="--d:240ms">
          <a href={`mailto:${d.contact.email}`} class="btn btn-primary">
            {d.hero.primary}
            <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
          </a>
          <a href="#saas" class="btn btn-ghost">{d.hero.secondary}</a>
        </div>
        <dl class="reveal mt-12 grid grid-cols-3 gap-4 border-t border-line pt-8" style="--d:320ms">
          {
            d.hero.stats.map((s) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-xs text-muted sm:text-sm">{s.label}</dt>
                <dd class="text-xl font-bold sm:text-3xl">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Visual -->
      <div class="reveal relative mx-auto w-full max-w-xl pb-10 lg:max-w-none" style="--d:200ms" aria-hidden="true">
        <DashboardMock class="float-slow me-10 sm:me-16" />
        <div class="float absolute -bottom-2 end-0">
          <PhoneMock variant={1} class="w-32 sm:w-40" />
        </div>
        <div
          class="float absolute -top-4 end-4 hidden items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2 text-sm font-semibold shadow-[var(--shadow)] sm:flex"
          style="animation-delay:-2s"
        >
          <span class="grid size-6 place-items-center rounded-full bg-tint text-accent"><Icon name="check" size={14} /></span>
          {d.hero.chipA}
        </div>
        <div
          class="float-slow absolute bottom-6 start-0 hidden items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2 text-sm font-semibold shadow-[var(--shadow)] sm:flex"
        >
          <span class="text-accent" dir="ltr">+128</span>
          {d.hero.chipB}
        </div>
      </div>
    </div>

    <!-- Tech marquee -->
    <div class="relative border-y border-line bg-soft/60 py-5">
      <p class="sr-only">{d.stack.title}</p>
      <div
        class="overflow-hidden"
        style="mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)"
        aria-hidden="true"
      >
        <div class="marquee">
          {stack.map((item) => <span class="whitespace-nowrap text-sm font-semibold text-muted" dir="ltr">{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- SaaS -->
  <section id="saas" class="section overflow-hidden">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <div class="reveal">
          <span class="eyebrow mb-4">{d.home.saas.eyebrow}</span>
          <h2 class="h-section">{d.home.saas.title}</h2>
          <p class="lead mt-4">{d.home.saas.desc}</p>
        </div>
        <div class="mt-8"><CheckList items={d.home.saas.points} /></div>
        <a href={lp(lang, '/saas')} class="btn btn-primary reveal mt-9">
          {d.home.saas.cta}
          <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
        </a>
      </div>
      <div class="reveal relative" style="--d:150ms">
        <div class="blob -inset-10 size-auto" aria-hidden="true"></div>
        <DashboardMock class="relative" />
      </div>
    </div>
  </section>

  <!-- Mobile -->
  <section id="mobile" class="section overflow-hidden bg-soft">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal relative flex justify-center gap-4 sm:gap-6 lg:order-first" aria-hidden="true">
        <div class="blob -inset-10 size-auto"></div>
        <PhoneMock variant={0} class="float relative mt-10 w-[38vw] max-w-36 sm:w-44 sm:max-w-none" />
        <PhoneMock variant={3} class="float-slow relative w-[38vw] max-w-36 sm:w-44 sm:max-w-none" />
        <PhoneMock variant={2} class="float relative mt-16 hidden w-44 sm:block" />
      </div>
      <div class="order-first lg:order-none">
        <div class="reveal">
          <span class="eyebrow mb-4">{d.home.mobile.eyebrow}</span>
          <h2 class="h-section">{d.home.mobile.title}</h2>
          <p class="lead mt-4">{d.home.mobile.desc}</p>
        </div>
        <div class="mt-8"><CheckList items={d.home.mobile.points} /></div>
        <a href={lp(lang, '/mobile-apps')} class="btn btn-primary reveal mt-9">
          {d.home.mobile.cta}
          <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="reveal max-w-2xl">
          <span class="eyebrow mb-4">{d.home.about.eyebrow}</span>
          <h2 class="h-section">{d.home.about.title}</h2>
          <p class="lead mt-4">{d.home.about.desc}</p>
        </div>
        <a href={lp(lang, '/about')} class="btn btn-ghost reveal self-start lg:self-auto">
          {d.home.about.cta}
          <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
        </a>
      </div>
      <div class="mt-12"><FeatureGrid items={d.values} cols={4} /></div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
