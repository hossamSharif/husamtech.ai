---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import Process from '../../components/Process.astro';
import DashboardMock from '../../components/DashboardMock.astro';
import CTA from '../../components/CTA.astro';
import { t, langPaths, type Lang } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang).saas;
---

<Base lang={lang} title={d.title} description={d.hero.desc}>
  <PageHero {...d.hero}>
    <DashboardMock class="float-slow" />
  </PageHero>

  <section class="section">
    <div class="container-x">
      <SectionHeading title={d.servicesTitle} desc={d.servicesDesc} />
      <div class="mt-12"><FeatureGrid items={d.services} /></div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container-x">
      <SectionHeading title={d.projectsTitle} desc={d.projectsDesc} />
      <div class="mt-12"><ProjectGrid items={d.projects} kind="saas" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHeading title={d.processTitle} />
      <div class="mt-12"><Process steps={d.process} /></div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>
